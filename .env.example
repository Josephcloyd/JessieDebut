# Copy to .env.local for development. Add the same values in Vercel for production.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# The public address of the site, with no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Any long random string. Vercel sends it to the daily keep-alive job.
CRON_SECRET=replace-with-a-long-random-string
